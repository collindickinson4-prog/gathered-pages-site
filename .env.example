# Kit (formerly ConvertKit) — newsletter signup.
# Copy this file to .env and fill in the real values. .env is gitignored.
#
# KIT_API_KEY  Kit dashboard -> Settings -> Developer -> API keys.
#              A V4 key looks like kit_xxxxxxxxxxxx. An older V3 key also works.
# KIT_FORM_ID  Kit dashboard -> Grow -> Landing Pages & Forms -> open the form.
#              The ID is the number in the URL, e.g. .../forms/1234567/edit

KIT_API_KEY=
KIT_FORM_ID=
