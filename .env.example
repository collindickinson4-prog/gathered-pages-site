# Kit (formerly ConvertKit) — newsletter signup.
# Copy this file to .env and fill in the real values. .env is gitignored.
#
# KIT_FORM_ID  Kit dashboard -> Grow -> Landing Pages & Forms -> open the form.
#              The ID is the number in the URL, e.g. .../forms/1234567/edit
#              No API key is needed. Signups go to the same endpoint Kit's own
#              embedded forms use, which is what keeps double opt-in working.

KIT_FORM_ID=

# Stripe — donations.
# STRIPE_SECRET_KEY  Stripe dashboard -> Developers -> API keys -> Secret key.
#                    Starts sk_test_ while you are testing, sk_live_ once
#                    giving is open. Never commit the real value.
# SITE_URL           Optional. The origin Stripe should send donors back to,
#                    e.g. https://www.gatheredpages.org. Leave blank and the
#                    function works it out from the request.

STRIPE_SECRET_KEY=
SITE_URL=

# Resend — year-end giving statements only. Nothing on the website sends mail.
# RESEND_API_KEY  resend.com -> API Keys. Starts re_.
# RESEND_FROM     The verified sender, e.g.
#                 Gathered Pages Collective <jamie@send.gatheredpages.org>
#                 Verify a subdomain in Resend so the Google Workspace MX
#                 records for gatheredpages.org are left alone.

# CONTACT_TO      Optional. Where the contact form lands. Defaults to
#                 jamie@gatheredpages.org.

RESEND_API_KEY=
RESEND_FROM=
CONTACT_TO=
